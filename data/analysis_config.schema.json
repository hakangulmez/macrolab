{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://macrolab.local/schemas/analysis_config.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "snapshot_id": {
      "type": "string"
    },
    "countries": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 50
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "concept_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,60}$"
          },
          "role": {
            "enum": [
              "shock",
              "response",
              "endogenous",
              "exogenous",
              "dependent",
              "regressor"
            ]
          },
          "transform": {
            "enum": [
              "level",
              "log",
              "diff",
              "log_diff",
              "yoy_pct",
              "yoy_diff",
              "qoq_saar",
              "index_to_base",
              "hp_cycle",
              "hamilton_cycle"
            ]
          },
          "transform_params": {
            "type": "object"
          }
        },
        "required": [
          "concept_id",
          "role",
          "transform"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 20
    },
    "frequency": {
      "enum": [
        "M",
        "Q",
        "A"
      ]
    },
    "aggregation": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "mean",
          "last",
          "sum"
        ]
      }
    },
    "sample": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "special_periods": {
      "type": "object",
      "properties": {
        "covid": {
          "enum": [
            "include",
            "dummy",
            "exclude"
          ]
        },
        "elb_threshold": {
          "type": "number"
        },
        "covid_window": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "covid"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "id": {
          "enum": [
            "desc.plot",
            "desc.corr",
            "desc.compare",
            "test.adf_kpss_pp",
            "sing.ols",
            "sing.ardl",
            "sing.rolling",
            "test.granger",
            "filter.hp",
            "filter.hamilton",
            "var.ols",
            "ident.recursive"
          ]
        },
        "params": {
          "type": "object"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "identification": {
      "type": [
        "object",
        "null"
      ]
    },
    "outputs": {
      "type": "object",
      "properties": {
        "confidence": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "irf": {
          "type": "object",
          "properties": {
            "horizon": {
              "type": "integer",
              "minimum": 1,
              "maximum": 80
            },
            "bands": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "shock_mode": {
              "enum": [
                "fixed",
                "one_sd"
              ]
            },
            "shock_size": {
              "type": "number"
            },
            "method": {
              "enum": [
                "bootstrap",
                "asymptotic"
              ]
            },
            "draws": {
              "type": "integer",
              "minimum": 20,
              "maximum": 10000
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "comparison": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "identifications": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "scenarios": {
          "type": "array",
          "items": {
            "enum": [
              "covid_include",
              "end_2019",
              "full_sample",
              "recent_half_full_sample",
              "quarterly_okun",
              "extended_var",
              "lag_criteria"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    }
  },
  "required": [
    "schema_version",
    "snapshot_id",
    "countries",
    "series",
    "frequency",
    "model"
  ],
  "additionalProperties": false
}
